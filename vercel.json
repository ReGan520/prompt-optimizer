{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container"
    },
    "mkdocs": {
      "root": "mkdocs",
      "runtime": "python"
    },
    "extension": {
      "root": "packages/extension",
      "framework": "vite"
    },
    "mcp-server": {
      "root": "packages/mcp-server",
      "framework": "express"
    },
    "ui": {
      "root": "packages/ui",
      "framework": "vite"
    },
    "web": {
      "root": "packages/web",
      "framework": "vite"
    },
    "site": {
      "root": "site",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}