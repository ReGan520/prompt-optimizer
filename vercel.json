{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "pnpm install",
      "buildCommand": "pnpm build",
      "outputDirectory": "packages/web/dist",
      "rewrites": [
        {
          "source": "/api/:path*",
          "destination": "/api/:path*"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "master": true,
      "develop": true
    }
  },
  "build": {
    "env": {
      "VITE_VERCEL_DEPLOYMENT": "true"
    }
  }
}
